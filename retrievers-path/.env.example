# Copy this file to .env.local (same folder) and fill in the values.
# .env.local is git-ignored, so your keys never get committed.

# AI-personalized plans (Claude). Get a key at https://console.anthropic.com
# Without it, the app uses the built-in offline planner.
ANTHROPIC_API_KEY=

# Live federal job postings on the dashboard. Free key: https://developer.usajobs.gov/APIRequest/Index
# USAJOBS_EMAIL must be the email you registered the key with.
USAJOBS_API_KEY=
USAJOBS_EMAIL=
